{
  "manifest_version": 3,
  "name": "Tabgeist",
  "version": "0.1.2",
  "description": "Lets your AI agents work in your own Chrome or Edge tabs, signed in as you, with your approval for every risky step.",
  "key": "",
  "minimum_chrome_version": "125",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "alarms",
    "scripting",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Tabgeist",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
